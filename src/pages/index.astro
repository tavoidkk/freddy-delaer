---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappUrl } from '../config/site';
const whatsapp = whatsappUrl();
const phone = site.phone.replace(/[^+\d]/g, '');
const featuredModels = [
  { name: 'Corolla', note: 'Un clásico para todos los días', image: 'https://tmna.aemassets.toyota.com/is/image/toyota/toyota/jellies/relative/2026/corolla/base.png?wid=1140&hei=600&fmt=jpg&fit=crop', imageAlt: 'Toyota Corolla, imagen oficial de Toyota' },
  { name: 'Camry', note: 'Comodidad para cada recorrido', image: 'https://tmna.aemassets.toyota.com/is/image/toyota/toyota/jellies/relative/2026/camry/base.png?wid=1140&hei=600&fmt=jpg&fit=crop', imageAlt: 'Toyota Camry, imagen oficial de Toyota' },
  { name: 'RAV4', note: 'Espacio y versatilidad para tu día', image: 'https://tmna.aemassets.toyota.com/is/image/toyota/toyota/jellies/relative/2026/rav4/base.png?wid=1140&hei=600&fmt=jpg&fit=crop', imageAlt: 'Toyota RAV4, imagen oficial de Toyota' },
  { name: 'Tacoma', note: 'Lista para trabajo y aventura', image: 'https://tmna.aemassets.toyota.com/is/image/toyota/toyota/jellies/relative/2026/tacoma/base.png?wid=1140&hei=600&fmt=jpg&fit=crop', imageAlt: 'Toyota Tacoma, imagen oficial de Toyota' },
  { name: 'Sienna', note: 'Espacio para compartir el camino', image: 'https://tmna.aemassets.toyota.com/is/image/toyota/toyota/jellies/relative/2026/sienna/base.png?wid=1140&hei=600&fmt=jpg&fit=crop', imageAlt: 'Toyota Sienna, imagen oficial de Toyota' },
  { name: '4Runner', note: 'Lista para explorar nuevos caminos', image: 'https://tmna.aemassets.toyota.com/is/image/toyota/toyota/jellies/relative/2026/4runner/base.png?wid=1140&hei=600&fmt=jpg&fit=crop', imageAlt: 'Toyota 4Runner, imagen oficial de Toyota' },
];
---
<Base title="Freddy Díaz | Asesor en Don McGill Toyota Houston" description="Habla con Freddy Díaz, asesor de ventas en Don McGill Toyota. Explora modelos Toyota y solicita una cita en Houston, Texas.">
  <a class="skip-link" href="#contenido">Ir al contenido</a>
  <header class="site-header" id="inicio">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="Freddy Díaz Toyota Dealer, inicio">
        <img class="dealer-logo" src="/images/don-mcgill-toyota-logo.png" alt="Don McGill Toyota" width="150" height="48" />
        <span class="brand-text"><strong>FREDDY DÍAZ</strong><small>ASESOR DE VENTAS</small></span>
      </a>
      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href="#freddy">Conoce a Freddy</a><a href="#beneficios">Beneficios</a><a href="#vehiculos">Modelos</a><a href="#proceso">Cómo funciona</a>
      </nav>
      <div class="header-actions">
        {phone && <a class="header-phone" href={`tel:${phone}`}><Icon name="phone" size={17} /> {site.phoneLabel}: {site.phone}</a>}
        <a class="button button-small button-dark" href="#cita">Cuéntanos qué buscas <Icon name="arrow" size={17} /></a>
        <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-controls="mobile-nav" aria-expanded="false"><Icon name="menu" /></button>
      </div>
    </div>
    <nav class="mobile-nav" id="mobile-nav" aria-label="Navegación móvil" hidden>
      <a href="#freddy">Conoce a Freddy</a><a href="#beneficios">Beneficios</a><a href="#vehiculos">Modelos</a><a href="#proceso">Cómo funciona</a><a href="#cita">Cuéntanos qué buscas</a>
    </nav>
  </header>

  <main id="contenido">
    <section class="hero personal-hero" aria-labelledby="hero-title">
      <div class="container personal-hero-grid">
        <div class="personal-hero-copy">
          <p class="eyebrow"><span class="eyebrow-line"></span> FREDDY DÍAZ · DON MCGILL TOYOTA</p>
          <h1 id="hero-title">Tu próximo Toyota empieza con <em>una conversación.</em></h1>
          <p class="hero-copy">Soy Freddy. Cuéntanos qué necesitas y te ayudamos a entender tus opciones, con atención personal y sin complicar el camino.</p>
          <div class="hero-actions"><a class="button button-red" href="#cita">Cuéntanos qué estás buscando <Icon name="arrow" size={19} /></a><a class="text-link" href="#freddy">Conoce cómo te ayudamos <span>↓</span></a></div>
          <div class="hero-note"><span class="hero-note-icon"><Icon name="calendar" size={18} /></span><span>Don McGill Toyota · Houston, Texas</span></div>
        </div>
        <div class="personal-hero-media">
          <div class="portrait-frame"><img src="/images/freddy-portrait.png" alt="Retrato editado de Freddy Díaz con traje profesional y lentes de ver" width="1024" height="1536" fetchpriority="high" /></div>
          <div class="portrait-caption"><span class="portrait-caption-line"></span><div><strong>FREDDY DÍAZ</strong><small>Tu asesor para el próximo paso</small></div></div>
          <span class="portrait-vertical" aria-hidden="true">ATENCIÓN PERSONAL · TOYOTA</span>
        </div>
      </div>
    </section>

    <section class="trust-bar" aria-label="Nuestra forma de ayudarte">
      <div class="container trust-grid"><div><Icon name="check" /><span>Atención personalizada</span></div><div><Icon name="check" /><span>Opciones para primeros compradores</span></div><div><Icon name="check" /><span>Beneficios para tu tranquilidad</span></div></div>
    </section>

    <section class="dealer-details" aria-label="Ubicación y horario del concesionario">
      <div class="container dealer-details-inner">
        <div class="dealer-detail"><Icon name="mapPin" size={20} /><div><strong>Visítanos</strong><a href="https://maps.google.com/?q=Don+McGill+Toyota+11800+Katy+Freeway+Houston+TX+77079" target="_blank" rel="noopener noreferrer">{site.address}, {site.city}</a></div></div>
        <div class="dealer-detail"><Icon name="clock" size={20} /><div><strong>Horario para visitarnos</strong><span>{site.hours}</span></div></div>
      </div>
    </section>

    <section class="intro section-pad" id="freddy">
      <div class="container intro-grid">
        <div data-reveal><p class="eyebrow"><span class="eyebrow-line"></span> CONOCE A FREDDY</p><h2>Un asesor de tu lado.<br /><span>Una decisión más clara.</span></h2></div>
        <div class="intro-right" data-reveal><p>Trabajo como asesor en Don McGill Toyota, concesionario autorizado en Houston. Cuéntanos qué necesitas: te ayudamos a explorar los modelos disponibles, resolver tus preguntas y coordinar una visita a tu ritmo.</p><a class="underlined-link" href="#cita">Cuéntanos qué buscas <Icon name="arrow" size={18} /></a></div>
      </div>
      <div class="container feature-grid" id="beneficios">
        <article class="feature-card" data-reveal><div class="feature-number">01</div><div class="feature-icon"><Icon name="spark" size={29} /></div><h3>Primeros compradores</h3><p>Explora programas diseñados para ayudarte a dar el primer paso, incluso si estás comenzando a construir tu crédito.</p></article>
        <article class="feature-card" data-reveal><div class="feature-number">02</div><div class="feature-icon"><Icon name="shield" size={29} /></div><h3>Compra con tranquilidad</h3><p>Consulta la disponibilidad de garantía de por vida en motor y transmisión, y dos años de mantenimiento sin costo.</p></article>
        <article class="feature-card" data-reveal><div class="feature-number">03</div><div class="feature-icon"><Icon name="calendar" size={29} /></div><h3>Asesoría a tu medida</h3><p>Cuéntanos qué vehículo te interesa y te ayudamos a revisar opciones y coordinar el siguiente paso.</p></article>
      </div>
      <div class="container"><p class="section-disclaimer">Las opciones de financiamiento mencionadas requieren puntaje de crédito superior a 580 y licencia de conducir válida. Programas, inicial, aprobación, garantía y mantenimiento dependen de elegibilidad, vehículo y términos vigentes. Consulta las condiciones por escrito antes de tomar una decisión.</p></div>
    </section>

    <section class="inventory-section section-pad" id="vehiculos">
      <div class="container inventory-head" data-reveal><div><p class="eyebrow"><span class="eyebrow-line"></span> MODELOS TOYOTA</p><h2>Hay un Toyota para<br /><span>cada camino.</span></h2></div><p>Explora algunos modelos destacados y cuéntanos cuál va mejor con lo que necesitas. Te ayudamos a revisar disponibilidad en Don McGill Toyota.</p></div>
      <div class="container model-grid-wrap" data-reveal>
        <div class="model-grid" id="model-grid" aria-label="Modelos Toyota destacados">
          {featuredModels.map((model, index) => <article class="model-card" data-reveal><div class="model-photo"><img src={model.image} alt={model.imageAlt} loading="lazy" decoding="async" width="1140" height="600" /><span class="model-number">{String(index + 1).padStart(2, '0')}</span></div><div class="model-card-content"><div><strong>Toyota {model.name}</strong><span>{model.note}</span></div></div><button class="model-card-action" type="button" data-model-select={model.name}>Me interesa este modelo <Icon name="arrow" size={17} /></button></article>)}
        </div>
      </div>
      <div class="container inventory-cta" data-reveal><span>La disponibilidad cambia con frecuencia. Cuéntanos cuál te interesa y Freddy te ayudará a revisar opciones.</span><a class="button button-dark" href="#cita">Quiero que me orienten <Icon name="arrow" size={18} /></a></div>
    </section>

    <section class="finance-band" aria-labelledby="finance-title">
      <div class="container finance-layout"><div data-reveal><p class="eyebrow light"><span class="eyebrow-line"></span> OPCIONES DE FINANCIAMIENTO</p><h2 id="finance-title">Un comienzo que<br /><em>se adapta a ti.</em></h2></div><div class="finance-content" data-reveal><p>Cuéntanos si estás comenzando a comprar. Te ayudamos a consultar los programas para primeros compradores y las opciones de inicial, que pueden incluir alternativas desde <strong>$2,000</strong> o, si calificas, <strong>cero enganche</strong>.</p><p>Para explorar estas opciones se requiere un puntaje de crédito superior a <strong>580</strong> y una <strong>licencia de conducir válida</strong>. La aprobación, el enganche y los términos finales dependen de la evaluación individual y del programa disponible. No pedimos tu puntaje ni documentos en esta página.</p><a class="button button-white" href="#cita">Cuéntanos qué necesitas <Icon name="arrow" size={18} /></a></div></div>
    </section>

    <section class="process section-pad" id="proceso">
      <div class="container process-head" data-reveal><div><p class="eyebrow"><span class="eyebrow-line"></span> SIMPLE DESDE EL PRIMER MOMENTO</p><h2>Así comienza <span>tu camino.</span></h2></div><p>Tres pasos para que nos cuentes qué necesitas y te ayudemos a explorar tu próximo Toyota.</p></div>
      <div class="container steps"><article data-reveal><span class="step-number">01</span><div class="step-rule"></div><h3>Cuéntanos qué buscas</h3><p>Completa el formulario con tus datos y el vehículo que tienes en mente.</p></article><article data-reveal><span class="step-number">02</span><div class="step-rule"></div><h3>Te ayudamos a explorar</h3><p>Freddy y el equipo conversarán contigo, responderán tus preguntas y revisarán tus prioridades.</p></article><article data-reveal><span class="step-number">03</span><div class="step-rule"></div><h3>Coordinamos tu visita</h3><p>Si te parece bien, acordaremos contigo una cita para dar el siguiente paso.</p></article></div>
    </section>

    <section class="form-section" id="cita">
      <div class="container form-layout"><div class="form-aside" data-reveal><p class="eyebrow light"><span class="eyebrow-line"></span> TU PRÓXIMO PASO</p><h2>Hablemos de<br /><em>lo que buscas.</em></h2><p>Cuéntanos un poco de ti y te ayudamos a explorar opciones y coordinar una cita en Don McGill Toyota.</p><div class="aside-rule"></div><div class="aside-points"><div><Icon name="clock" size={21} /><span>{site.hours}</span></div><div><Icon name="shield" size={21} /><span>Opciones sujetas a elegibilidad y aprobación.</span></div></div>{whatsapp ? <a class="aside-whatsapp" href={whatsapp} target="_blank" rel="noopener noreferrer"><span class="aside-whatsapp-mark"><Icon name="whatsapp" size={22} /></span><span>Cuéntanos por WhatsApp</span><Icon name="arrow" size={17} /></a> : <span class="aside-whatsapp aside-whatsapp-disabled" aria-disabled="true"><span class="aside-whatsapp-mark"><Icon name="whatsapp" size={22} /></span><span>WhatsApp disponible próximamente</span></span>}</div>
      <div class="form-card" data-reveal>
        <div class="form-card-head"><span>UNA SOLICITUD SENCILLA · 2 PASOS</span><h3>Cuéntale a Freddy qué buscas</h3><p>Primero elegimos por dónde comenzar; después nos dejas tus datos.</p></div>
        <div class="form-progress" role="progressbar" aria-label="Progreso del formulario" aria-valuemin="1" aria-valuemax="2" aria-valuenow="1"><span data-progress-label>Paso 1 de 2</span><div class="form-progress-track"><span data-progress-bar></span></div></div>
        <form id="lead-form" novalidate>
          <section class="form-step is-active" data-form-step="1" aria-labelledby="form-step-one-title">
            <div class="form-step-heading"><span>01</span><div><h4 id="form-step-one-title" tabindex="-1">Empecemos por el Toyota</h4><p>¿Cuál te gustaría explorar?</p></div></div>
            <div class="field"><label for="vehicle">Vehículo de interés *</label><select id="vehicle" name="vehicle" required><option value="">Selecciona un modelo</option>{['Corolla', 'Camry', 'RAV4', 'Tacoma', 'Tundra', 'Highlander', 'Grand Highlander', '4Runner', 'Corolla Cross', 'Sienna', 'Prius', 'Otro modelo Toyota', 'Vehículo usado', 'Aún no lo sé'].map((model) => <option value={model}>{model}</option>)}</select><small class="field-error" id="vehicle-error" aria-live="polite"></small></div>
            <div class="field"><label for="priority">¿Qué te ayudaría a avanzar? *</label><select id="priority" name="priority" required><option value="">Elige una opción</option><option value="Encontrar una cuota que se ajuste a mi presupuesto">Encontrar una cuota cómoda para mi presupuesto</option><option value="Conocer opciones de financiamiento">Conocer mis opciones de financiamiento</option><option value="Elegir el modelo y tamaño adecuado">Elegir el Toyota adecuado para mi día a día</option><option value="Explorar opciones para primeros compradores">Explorar opciones para primeros compradores</option><option value="Conocer inicial y elegibilidad">Consultar inicial y elegibilidad</option><option value="Comparar beneficios y cobertura">Comparar beneficios y cobertura</option><option value="Aún no lo tengo claro">Todavía no lo tengo claro</option></select><small class="field-error" id="priority-error" aria-live="polite"></small></div>
            <button class="button button-red form-next" type="button" data-form-next>Continuar con mis datos <Icon name="arrow" size={19} /></button>
          </section>
          <section class="form-step" data-form-step="2" aria-labelledby="form-step-two-title" hidden>
            <div class="form-step-heading"><span>02</span><div><h4 id="form-step-two-title" tabindex="-1">¿Cómo te contactamos?</h4><p>Comparte tus datos y la forma que prefieres.</p></div></div>
            <div class="form-row"><div class="field"><label for="name">Nombre completo *</label><input id="name" name="name" autocomplete="name" required minlength="2" maxlength="100" placeholder="Tu nombre y apellido" /><small class="field-error" id="name-error" aria-live="polite"></small></div><div class="field"><label for="phone">Teléfono móvil *</label><input id="phone" name="phone" autocomplete="tel" inputmode="tel" required placeholder="(000) 000-0000" /><small class="field-error" id="phone-error" aria-live="polite"></small></div></div>
            <div class="field"><label for="email">Correo electrónico *</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="nombre@ejemplo.com" /><small class="field-error" id="email-error" aria-live="polite"></small></div>
            <fieldset class="field contact-field" data-contact-group aria-describedby="contactPreference-error"><legend>¿Cómo te gustaría que Freddy te contacte? *</legend><div class="contact-method-grid">
              <label class="contact-method"><input type="radio" name="contactPreference" value="Llamada" required /><span class="contact-method-card"><span class="contact-method-icon"><Icon name="phone" size={21} /></span><strong>Llamada</strong><small>Conversamos por teléfono</small></span></label>
              <label class="contact-method"><input type="radio" name="contactPreference" value="Mensaje de texto" required /><span class="contact-method-card"><span class="contact-method-icon"><Icon name="message" size={21} /></span><strong>Mensaje</strong><small>Te escribimos al móvil</small></span></label>
              <label class="contact-method"><input type="radio" name="contactPreference" value="WhatsApp" required /><span class="contact-method-card contact-method-whatsapp"><span class="contact-method-icon"><Icon name="whatsapp" size={22} /></span><strong>WhatsApp</strong><small>Te contactamos por WhatsApp</small></span></label>
            </div><small class="field-error" id="contactPreference-error" aria-live="polite"></small></fieldset>
            <div class="field"><label for="message">¿Algo más que debamos saber? <span>(opcional)</span></label><textarea id="message" name="message" rows="3" maxlength="500" placeholder="Cuéntanos qué buscas o qué preguntas tienes"></textarea></div>
            <div class="honeypot" aria-hidden="true"><label for="website">Sitio web</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
            <label class="check-field"><input id="consent" name="consent" type="checkbox" required /><span>He leído la <a href="/privacidad/" target="_blank" rel="noopener noreferrer">Política de privacidad</a> y autorizo que usen mis datos para atender esta solicitud y enviarme por correo promociones y novedades. Puedo cancelar esos correos en cualquier momento. *</span></label><small class="field-error check-error" id="consent-error" aria-live="polite"></small>
            <div class="form-step-actions"><button class="form-back" type="button" data-form-back><Icon name="chevron" size={17} /> Volver</button><button class="button button-red submit-button" type="submit">Enviar mi solicitud <Icon name="arrow" size={19} /></button></div>
            <p class="form-fine">Enviar este formulario no garantiza financiamiento, aprobación, un vehículo ni una cita confirmada. No incluyas números de identificación, Seguro Social ni información financiera sensible.</p>
          </section>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
        <div class="lead-success" id="lead-success" data-form-success hidden role="status" aria-live="polite">
          <div class="success-mark"><svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><circle cx="32" cy="32" r="27"/><path d="m19 32 9 9 18-19"/></svg></div>
          <p class="success-eyebrow">SOLICITUD RECIBIDA</p><h3 data-success-title>¡Gracias por escribirnos!</h3>
          <p data-success-copy>Freddy y su equipo se pondrán en contacto contigo para conversar y coordinar una cita.</p>
          {whatsapp && <a class="success-contact-link" href={whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={19} /> También puedes escribirle a Freddy</a>}
        </div>
      </div></div>
    </section>

    <section class="faq section-pad" id="preguntas"><div class="container faq-layout"><div data-reveal><p class="eyebrow"><span class="eyebrow-line"></span> RESPUESTAS CLARAS</p><h2>Antes de dar<br /><span>el primer paso.</span></h2><p class="faq-intro">¿Te queda una pregunta? Cuéntanosla en el formulario y te ayudamos.</p></div><div class="faq-list" data-reveal><details><summary>¿Qué necesito para explorar opciones de financiamiento? <Icon name="chevron" size={20} /></summary><div class="faq-answer"><div class="faq-answer-inner"><p>Para consultar los programas mencionados se requiere un puntaje de crédito superior a 580 y una licencia de conducir válida. La elegibilidad y los términos finales se determinan al revisar cada caso.</p></div></div></details><details><summary>¿La solicitud confirma mi cita? <Icon name="chevron" size={20} /></summary><div class="faq-answer"><div class="faq-answer-inner"><p>No. Recibiremos tus datos y Freddy o el equipo se comunicará contigo por el canal que prefieras para conversar y coordinar una fecha y hora.</p></div></div></details><details><summary>¿Debo enviar mi licencia o Seguro Social aquí? <Icon name="chevron" size={20} /></summary><div class="faq-answer"><div class="faq-answer-inner"><p>No. Este formulario solo recoge datos de contacto y preferencias. No escribas información sensible aquí. Si se requiere documentación más adelante, te indicaremos el proceso apropiado.</p></div></div></details><details><summary>¿Cómo puedo consultar un modelo? <Icon name="chevron" size={20} /></summary><div class="faq-answer"><div class="faq-answer-inner"><p>Selecciona el Toyota que te interesa en las tarjetas y el formulario se preparará con ese modelo. Freddy te ayudará a consultar disponibilidad en Don McGill Toyota.</p></div></div></details></div></div></section>
  </main>

  <footer class="footer"><div class="container footer-main"><div><a class="brand footer-brand" href="/"><img class="dealer-logo footer-dealer-logo" src="/images/don-mcgill-toyota-logo.png" alt="Don McGill Toyota" width="150" height="48" /><span class="brand-text"><strong>FREDDY DÍAZ</strong><small>ASESOR DE VENTAS</small></span></a><p>Cuéntanos qué necesitas. Te ayudamos a encontrar tu próximo Toyota.</p></div><div><span class="footer-label">EXPLORA</span><a href="#beneficios">Beneficios</a><a href="#vehiculos">Modelos</a><a href="#proceso">Cómo funciona</a><a href="#cita">Cuéntanos qué buscas</a></div><div><span class="footer-label">DON MCGILL TOYOTA</span><a href="https://maps.google.com/?q=Don+McGill+Toyota+11800+Katy+Freeway+Houston+TX+77079" target="_blank" rel="noopener noreferrer">{site.address}, {site.city}</a><span>{site.hours}</span>{phone && <a href={`tel:${phone}`}>{site.phoneLabel}: {site.phone}</a>}{site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}</div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} {site.name}</span><div><a href="/privacidad/">Política de privacidad</a><a href="/terminos/">Avisos y condiciones</a></div></div></footer>
  {whatsapp && <a class="whatsapp-float" href={whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Escribir a Freddy por WhatsApp"><Icon name="whatsapp" size={27} /></a>}
  <script src="../scripts/landing.ts"></script>
</Base>
